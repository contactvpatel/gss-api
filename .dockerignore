# Git
# Docker copies src/ after restoring, so host build outputs must stay out of the context.
.git
.gitignore

# Build outputs
**/bin
**/obj
**/out
**/*.binlog

# IDE and tools
.vscode
.idea
.cursor
.codegraph
*.user
*.suo

# Test and coverage
**/TestResults
**/coverage
*.trx
*.coverage

# Documentation and tooling (not needed in the image)
.docs
.claude
.github

# Tests and local environment
tests
.env
**/.env
**/.env.*

# SonarQube
.sonarqube

# Misc
**/.DS_Store
*.md
!README.md
