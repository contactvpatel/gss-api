<Project>
  <!--
    Imported after every package's build props: CodeStyle.NET's props set LangVersion=latest and
    AnalysisLevel=latest-default, which would override the same properties in Directory.Build.props.
    Pinned to the target framework, so an SDK upgrade alone never changes the language or adds analyzer rules
    (with TreatWarningsAsErrors, new rules would break the build). Bump both with TargetFramework:
    net10.0 = C# 14.0 and analysis level 10.0 (BuildSettingsTests checks every project).
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>
</Project>
