{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DbConnectionSettings": {
    "Read": {
      "Host": "set-via-environment",
      "Port": "set-via-environment",
      "DatabaseName": "set-via-environment",
      "MinPoolSize": 5,
      "MaxPoolSize": 20,
      "UserId": "set-via-environment",
      "Password": "set-via-environment"
    },
    "Write": {
      "Host": "set-via-environment",
      "Port": "set-via-environment",
      "DatabaseName": "set-via-environment",
      "MinPoolSize": 5,
      "MaxPoolSize": 20,
      "UserId": "set-via-environment",
      "Password": "set-via-environment"
    }
  },
  "DatabaseMigration": {
    "Enabled": true
  },
  "AppSettings": {
    "ApplicationName": "set-via-environment",
    "ApplicationVersion": "1.0.0",
    "Environment": "set-via-environment"
  },
  "CacheOptions": {
    "Enabled": false,
    "Mode": "Redis",
    "ApplicationPrefix": "gss-api",
    "EnvironmentPrefix": "set-via-environment",
    "DefaultExpiration": "00:10:00",
    "Redis": {
      "Configuration": "set-via-environment",
      "UseTls": true,
      "StrictCertificateValidation": false
    },
    "Security": {
      "AllowRawKeysInTelemetry": true
    }
  },
  "OpenTelemetryOptions": {
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "EnableNpgsqlInstrumentation": true,
    "CollectorUrl": "set-via-environment",
    "Meters": [ "ApiPipeline.NET" ],
    "TracingSources": [ "GSS.Api" ]
  },
  "HttpResilience": {
    "Timeout": {
      "Total": "00:00:30",
      "Attempt": "00:00:08"
    },
    "Retry": {
      "BaseDelay": "00:00:01"
    },
    "Connection": {
      "Enabled": true,
      "MaxConnectionsPerServer": 10,
      "AllowAutoRedirect": false
    }
  },
  "SsoService": {
    "Url": "set-via-environment",
    "Endpoint": {
      "ValidateToken": "user/validate/token",
      "RenewToken": "user/renewtoken",
      "Logout": "user/logout"
    }
  },
  "MisService": {
    "Url": "set-via-environment",
    "Headers": {
      "AuthAppId": "set-via-environment",
      "AuthAppSecret": "set-via-environment"
    },
    "Endpoint": {
      "GeoLevel": "Division/GeoLevel",
      "Department": "Department",
      "Entity": "Entity",
      "RoleType": "Division/RoleType",
      "Role": "Role",
      "Position": "Position",
      "PersonPosition": "Person/Position"
    },
    "Divisions": {
      "1": "North America",
      "2": "Australia New Zealand",
      "3": "UK-Europe",
      "4": "Middle East",
      "5": "Asia-India",
      "6": "Africa",
      "7": "South America",
      "8": "Other"
    }
  },
  "AsmService": {
    "Url": "set-via-environment",
    "Headers": {
      "AuthAppId": "set-via-environment",
      "AuthAppSecret": "set-via-environment"
    },
    "Endpoint": {
      "ApplicationSecurity": "application-security"
    }
  },
  "ApiPipeline": {
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ClearDefaultProxies": false,
      "ForwardLimit": 1
    },
    "Cors": {
      "Enabled": true,
      "AllowAllInDevelopment": true,
      "AllowedOrigins": [
        "https://your-production-domain.com",
        "https://www.your-production-domain.com"
      ],
      "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "AllowedHeaders": [ "*" ],
      "AllowCredentials": false,
      "PreflightMaxAge": "01:00:00"
    },
    "RateLimiting": {
      "Enabled": true,
      "DefaultPolicy": "global",
      "GlobalPolicy": "global",
      "Policies": [
        { "Name": "global", "Kind": "FixedWindow", "PermitLimit": 100, "Window": "00:01:00" },
        { "Name": "strict", "Kind": "FixedWindow", "PermitLimit": 10, "Window": "00:01:00" },
        { "Name": "renew", "Kind": "FixedWindow", "PermitLimit": 10, "Window": "00:01:00" }
      ],
      "ExcludedPaths": [],
      "ProbeNetworks": []
    },
    "ResponseCompression": {
      "Enabled": true,
      "EnableForHttps": false,
      "ExcludedPaths": [ "/internal/health", "/health", "/healthz" ]
    },
    "RequestLimits": {
      "Enabled": true,
      "MaxRequestBodySize": 1048576
    },
    "VersionDeprecation": {
      "Enabled": false,
      "DeprecatedVersions": []
    }
  }
}
