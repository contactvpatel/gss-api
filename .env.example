# .env.example — Documentation: What your app needs
#
# TEMPLATE (this file, committed):
#   Shows the structure and keys the app needs.
#   Has placeholder values only — no real secrets.
#   New developers copy this to understand what to configure.
#
# .env.local (not committed, .gitignored):
#   Your INSTANCE — holds actual secret values for your machine.
#   Created by you locally, never reaches the repo.
#   Auto-loaded at runtime in Development mode only.
#
# DEPLOYED ENVIRONMENTS (QA/UAT/Production):
#   Secrets MUST be injected from vault
#   Never store secrets in environment files, config files or code.
#   Deploy pipeline reads from vault and injects as environment variables at runtime.
#
# SETUP: Copy this file to .env.local, replace placeholders with real values.

# Application environment (Development, QA, UAT, Production)
AppSettings__Environment=Development
AppSettings__ApplicationName=gss-api-dev

# Database connection settings (Read and Write)
DbConnectionSettings__Read__Host=localhost
DbConnectionSettings__Read__Port=5432
DbConnectionSettings__Read__DatabaseName=gss
DbConnectionSettings__Read__UserId=postgres
DbConnectionSettings__Read__Password=set-via-environment
DbConnectionSettings__Write__Host=localhost
DbConnectionSettings__Write__Port=5432
DbConnectionSettings__Write__DatabaseName=gss
DbConnectionSettings__Write__UserId=postgres
DbConnectionSettings__Write__Password=set-via-environment

# External service URLs
SsoService__Url=https://api.uat.bapsapps.org/sso/api/
MisService__Url=https://api.uat.bapsapps.org/myseva/api/v1/
AsmService__Url=https://api.uat.bapsapps.org/asm/api/v2/

# MIS Service credentials
MisService__Headers__AuthAppId=set-via-environment
MisService__Headers__AuthAppSecret=set-via-environment

# ASM Service credentials
AsmService__Headers__AuthAppId=set-via-environment
AsmService__Headers__AuthAppSecret=set-via-environment

# Caching (Redis in non-dev environments)
CacheOptions__Redis__Configuration=cache.dev.bapsapps.org:6379
CacheOptions__EnvironmentPrefix=dev

# Observability
OpenTelemetryOptions__CollectorUrl=http://localhost:4317
